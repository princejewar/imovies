PORT=5000
MONGODB_CONNECTION_LINK=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=change_this_to_a_long_random_string
# Needed to register an admin account (type it into the "Register as an Admin" form)
ADMIN_ACCESS_CODE=imovies-admin
# Only needed if the frontend is hosted on a different domain
CLIENT_URL=http://localhost:5173

# Optional email notifications (leave empty to only show alerts inside the app)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=iMovies <no-reply@imovies.local>

# Demo: chance (0 to 1) that the simulated payment gateway declines a payment
PAYMENT_FAIL_RATE=0
